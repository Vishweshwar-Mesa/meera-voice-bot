# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use
GEMINI_MODEL=gemini-2.5-flash

# Optional but recommended: a random string used to verify that webhook
# requests actually come from Telegram (set the same value when registering
# the webhook, see README.md)
TELEGRAM_WEBHOOK_SECRET=
