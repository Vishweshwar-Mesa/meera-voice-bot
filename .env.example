# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use for drafting
GEMINI_MODEL=gemini-3.6-flash

# Optional: which Gemini model to use for scoring/keyword extraction (fast,
# cheap tier — defaults to the same as GEMINI_MODEL if unset)
GEMINI_FLASH_MODEL=gemini-3.6-flash

# Optional but recommended: a random string used to verify that webhook
# requests actually come from Telegram (set the same value when registering
# the webhook, see README.md)
TELEGRAM_WEBHOOK_SECRET=

# Optional but recommended: restricts the bot to a single Telegram chat, so
# strangers who find the bot's username can't use it. Also required for the
# 6-monthly audience-profile reminder (see README.md) to know who to message.
# Leave unset until you know your chat id, then set it and redeploy.
ALLOWED_CHAT_ID=

# Optional but recommended: a random string that authenticates Vercel's own
# Cron trigger for the audience-profile reminder (Vercel sends it as
# "Authorization: Bearer <value>" automatically once this env var is set).
CRON_SECRET=
